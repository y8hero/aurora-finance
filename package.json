{
  "name": "aurora-core",
  "version": "0.1.0",
  "private": true,
  "description": "Aurora money layer - Phase 2 step 1 read-only sandbox probes",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx --env-file=.env watch src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "probe:maplerad": "tsx --env-file=.env scripts/probe-maplerad.ts",
    "probe:circle": "tsx --env-file=.env scripts/probe-circle.ts"
  },
  "dependencies": {
    "pino": "^9.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
